  "type": "module",
  "description": "A benchmark that asks whether npm dependency-risk signals actually predict anything.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
