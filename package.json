    "snapshot": "tsx src/snapshot/run.ts",
    "score": "tsx src/policies/run.ts",
    "report": "tsx src/harness/report.ts",
    "page": "tsx src/report/page.ts",
    "estimate": "tsx src/policies/estimate.ts",
    "seal": "tsx src/prospective/seal.ts",
